# Cấu hình CSDL SQLite hoặc PostgreSQL/MySQL
# Mặc định sử dụng SQLite tại backend/database/hybrid_store.db
DATABASE_URL=sqlite:///database/hybrid_store.db

# Nếu sử dụng PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/hybrid_store_db

# Nếu sử dụng MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/hybrid_store_db

# Cấu hình Host & Port cho máy chủ
HOST=0.0.0.0
PORT=8000
DEBUG=True
